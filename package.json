{
  "name": "creepjs-monorepo",
  "version": "1.0.0",
  "description": "CreepJS 2.0 - Educational browser fingerprinting platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@next/eslint-plugin-next": "^15.1.5",
    "@turbo/gen": "^2.11.10",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.18.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": "^0.16.8",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "defu@<6.1.5": "^6.1.5",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": "^13.2.1",
      "minimatch@>=3.0.0 <3.1.3": "^3.1.3",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@>=3.0.0 <3.3.12": "^3.3.12",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.0.0 <6.1.5": "^6.1.5",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
