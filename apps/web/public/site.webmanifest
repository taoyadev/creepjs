{
  "name": "CreepJS - Browser Fingerprint & IP Risk Checker",
  "short_name": "CreepJS",
  "description": "Educational, privacy-first browser fingerprinting platform for developers and privacy research",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Fingerprint Checker",
      "short_name": "Checker",
      "description": "Run a full browser fingerprint scan",
      "url": "/checker",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "IP Risk Checker",
      "short_name": "IP Check",
      "description": "Check any IP for proxy, VPN and datacenter signals",
      "url": "/ip",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": ["developer", "utilities", "education"],
  "lang": "en",
  "dir": "ltr",
  "scope": "/",
  "prefer_related_applications": false
}
